ables><variable id=\"nj4Wa9*CPo]d*Nl)dhe4\">My_Monster</variable><variable type=\"KIND_SpriteKind\" id=\"!vI-;)b+8WF=jmTmN},v\">Player</variable><variable type=\"KIND_SpriteKind\" id=\"Tv@ID[tQq.KCv$VGL~l9\">Projectile</variable><variable type=\"KIND_SpriteKind\" id=\"kZ6_HkGK:P}Hd!u_-5q1\">Food</variable><variable type=\"KIND_SpriteKind\" id=\"%{#m6qJp*+F~5yo9hNXc\">Enemy</variable></variables><block type=\"pxt-on-start\" x=\"0\" y=\"0\"><statement name=\"HANDLER\"><block type=\"PixelPassportBluetooth_startReceiver\"></block></statement></block><block type=\"PixelPassportBluetooth_onMonsterReceived\" x=\"288\" y=\"0\"><statement name=\"HANDLER\"><block type=\"controls_if\"><value name=\"IF0\"><shadow type=\"logic_boolean\"><field name=\"BOOL\">TRUE</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"nj4Wa9*CPo]d*Nl)dhe4\">My_Monster</field></block></value><statement name=\"DO0\"><block type=\"spritedestroy2\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" _expanded=\"0\" _input_init=\"true\"></mutation><field name=\"effect\">effects.spray</field><value name=\"sprite\"><block type=\"variables_get\"><field name=\"VAR\" id=\"nj4Wa9*CPo]d*Nl)dhe4\">My_Monster</field></block></value><value name=\"duration\"><shadow type=\"timePicker\"><field name=\"ms\">500</field></shadow></value></block></statement><next><block type=\"variables_set\"><field name=\"VAR\" id=\"nj4Wa9*CPo]d*Nl)dhe4\">My_Monster</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"spritescreate\"><value name=\"img\"><shadow type=\"screen_image_picker\"><field name=\"img\"></field></shadow><block type=\"PixelPassportBluetooth_monsterImage\"></block></value><value name=\"kind\"><shadow type=\"spritekind\"><field name=\"MEMBER\">Player</field></shadow></value></block></value><next><block type=\"spritesetpos\"><value name=\"sprite\"><block type=\"variables_get\"><field name=\"VAR\" id=\"nj4Wa9*CPo]d*Nl)dhe4\">My_Monster</field></block></value><value name=\"x\"><shadow type=\"positionPicker\"><field name=\"index\">80</field></shadow></value><value name=\"y\"><shadow type=\"positionPicker\"><field name=\"index\">60</field></shadow></value><next><block type=\"sprite_set_scale\"><field name=\"anchor\">ScaleAnchor.Middle</field><value name=\"sprite\"><block type=\"variables_get\"><field name=\"VAR\" id=\"nj4Wa9*CPo]d*Nl)dhe4\">My_Monster</field></block></value><value name=\"value\"><shadow type=\"math_number\"><field name=\"NUM\">3</field></shadow></value></block></next></block></next></block></next></block></statement></block></xml>","main.ts":"","README.md":" ","assets.json":"","custom.ts":"/**\n * Pixel Passport (Bluetooth) Extension\n * MakeCode Arcade + Browser Events extension required.\n * Receives the existing 269-character Pixel Passport format.\n */\n//% color=\"#7952B3\" weight=90 block=\"Pixel Passport\"\nnamespace PixelPassportBluetooth {\n    const TOTAL = 269\n    const PIXELS = \"0123456789ABCDEF\"\n    const CODES = \"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n    const FACINGS = \"LFR\"\n\n    let started = false\n    let state = 0 // 0 waiting, 1 receiving, 2 complete, 3 error\n    let incoming = \"\"\n    let lastKeyTime = 0\n    let errorText = \"\"\n    let drawLoadingBar = true\n    let receivedHandler: () => void = null\n    let errorHandler: () => void = null\n    let spriteArt = image.create(16, 16)\n    let facing = \"\"\n    let typeCode = \"\"\n    let health = 0\n    let attack = 0\n    let speed = 0\n    let reserved = \"\"\n\n    // Order must match CODES exactly: 0-9 followed by A-Z.\n    const keys = [\n        browserEvents.Zero, browserEvents.One, browserEvents.Two,\n        browserEvents.Three, browserEvents.Four, browserEvents.Five,\n        browserEvents.Six, browserEvents.Seven, browserEvents.Eight,\n        browserEvents.Nine, browserEvents.A, browserEvents.B,\n        browserEvents.C, browserEvents.D, browserEvents.E,\n        browserEvents.F, browserEvents.G, browserEvents.H,\n        browserEvents.I, browserEvents.J, browserEvents.K,\n        browserEvents.L, browserEvents.M, browserEvents.N,\n        browserEvents.O, browserEvents.P, browserEvents.Q,\n        browserEvents.R, browserEvents.S, browserEvents.T,\n        browserEvents.U, browserEvents.V, browserEvents.W,\n        browserEvents.X, browserEvents.Y, browserEvents.Z\n    ]\n\n    function fail(message: string) {\n        errorText = message\n        state = 3\n        console.log(\"Pixel Passport: \" + message + \" (\" + incoming.length + \"/269)\")\n        if (errorHandler) errorHandler()\n    }\n\n    function decodeMonster() {\n        // Same validation and decoding as the working compact receiver.\n        for (let i = 0; i < 256; i++) {\n            if (PIXELS.indexOf(incoming.charAt(i)) < 0) {\n                fail(\"INVALID SPRITE\")\n                return\n            }\n        }\n        if (FACINGS.indexOf(incoming.charAt(256)) < 0) {\n            fail(\"INVALID FACING\")\n            return\n        }\n        for (let i = 257; i < TOTAL; i++) {\n            if (CODES.indexOf(incoming.charAt(i)) < 0) {\n                fail(\"INVALID DATA\")\n                return\n            }\n        }\n        let nextArt = image.create(16, 16)\n        for (let i = 0; i < 256; i++) {\n            nextArt.setPixel(i % 16, Math.idiv(i, 16),\n                PIXELS.indexOf(incoming.charAt(i)))\n        }\n        spriteArt = nextArt\n        facing = incoming.charAt(256)\n        typeCode = incoming.charAt(257)\n        health = CODES.indexOf(incoming.charAt(258))\n        attack = CODES.indexOf(incoming.charAt(259))\n        speed = CODES.indexOf(incoming.charAt(260))\n        reserved = incoming.substr(261, 8)\n        errorText = \"\"\n        state = 2\n        if (receivedHandler) receivedHandler()\n    }\n\n    function receiveCharacter(letter: string) {\n        if (state != 1) {\n            incoming = \"\"\n            errorText = \"\"\n            state = 1\n        }\n        incoming += letter\n        lastKeyTime = game.runtime()\n        if (incoming.length == TOTAL) decodeMonster()\n    }\n\n    // A named function keeps the correct index in every callback.\n    function registerKey(index: number) {\n        keys[index].onEvent(browserEvents.KeyEvent.Pressed, function () {\n            receiveCharacter(CODES.charAt(index))\n        })\n    }\n\n    function showProgress() {\n        if (!drawLoadingBar || state != 1) return\n        screen.fill(1)\n        screen.fillRect(13, 55, 134, 16, 15)\n        screen.fillRect(15, 57, 130, 12, 1)\n        screen.fillRect(15, 57, Math.idiv(incoming.length * 130, TOTAL), 12, 7)\n        let count = \"\" + incoming.length + \" / 269\"\n        screen.print(count, Math.idiv(160 - count.length * 6, 2), 80, 15)\n    }\n\n    /** Start listening for Bluetooth keyboard input once per game. */\n    //% block=\"start Bluetooth receiver\"\n    //% weight=100\n    export function startReceiver() {\n        if (started) return\n        started = true\n        for (let i = 0; i < keys.length; i++) registerKey(i)\n        game.onUpdateInterval(250, function () {\n            if (state == 1 && game.runtime() - lastKeyTime > 8000) {\n                fail(\"SCAN TIMED OUT\")\n            }\n        })\n        game.onPaint(function () {\n            showProgress()\n        })\n    }\n\n    /** Run when a complete monster has arrived. */\n    //% block=\"on monster received\"\n    //% weight=95\n    export function onMonsterReceived(handler: () => void) {\n        receivedHandler = handler\n    }\n\n    /** The monster's original 16x16 pixel image. */\n    //% block=\"monster image\"\n    //% weight=90\n    export function monsterImage(): Image {\n        return spriteArt.clone()\n    }\n\n    /** The monster's one-letter type. */\n    //% block=\"monster type\"\n    //% weight=85\n    export function monsterType(): string {\n        return typeCode\n    }\n\n    /** The monster's facing (L, F, R). */\n    //% block=\"monster facing\"\n    //% weight=80\n    export function monsterFacing(): string {\n        return facing\n    }\n\n    /** Health value (0-35). */\n    //% block=\"monster health\"\n    //% weight=75\n    export function monsterHealth(): number {\n        return health\n    }\n\n    /** Attack value (0-35). */\n    //% block=\"monster attack\"\n    //% weight=70\n    export function monsterAttack(): number {\n        return attack\n    }\n\n    /** Speed value (0-35). */\n    //% block=\"monster speed\"\n    //% weight=65\n    export function monsterSpeed(): number {\n        return speed\n    }\n\n    /** True while importing a monster. */\n    //% block=\"monster is loading\"\n    //% weight=60\n    export function isLoading(): boolean {\n        return state == 1\n    }\n\n    /** Enable or disable the full-screen progress bar. */\n    //% block=\"show loading bar $enabled\"\n    //% enabled.shadow=\"toggleOnOff\"\n    //% weight=55\n    export function showLoadingBar(enabled: boolean) {\n        drawLoadingBar = enabled\n    }\n\n    /** Run when a transfer is incomplete or invalid. */\n    //% block=\"on monster scan error\"\n    //% weight=40 advanced=true\n    export function onMonsterError(handler: () => void) {\n        errorHandler = handler\n    }\n\n    /** The last error message. */\n    //% block=\"monster scan error text\"\n    //% weight=35 advanced=true\n    export function lastError(): string {\n        return errorText\n    }\n\n    /** The 8 reserved characters (future format use). */\n    //% block=\"monster reserved data\"\n    //% weight=30 advanced=true\n    export function monsterReserved(): string {\n        return reserved\n    }\n\n    /** Original 269-character code from last completed scan. */\n    //% block=\"monster raw code\"\n    //% weight=25 advanced=true\n    export function rawCode(): string {\n        if (state == 2) return incoming\n        return \"\"\n    }\n}\n","pxt.json":"{\n    \"name\": \"Pixel Passport (Bluetooth) Extension\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\",\n        \"browser-events\": \"*\",\n        \"arcade-sprite-data\": \"github:microsoft/arcade-sprite-data#v0.2.1\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\",\n        \"custom.ts\"\n    ],\n    \"preferredEditor\": \"blocksprj\"\n}\n"}},{"timestamp":1792386530322,"editorVersion":"4.1.25","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"Oou*Vk,sOPSoJh3Ay69Y\">My_Monster</variable><variable type=\"KIND_SpriteKind\" id=\"3!n~4y%$+//-}v/m{t4K\">Player</variable><variable type=\"KIND_SpriteKind\" id=\"c{pKi_E%UU^hB|6)g(w_\">Projectile</variable><variable type=\"KIND_SpriteKind\" id=\"Eoz%KWl-BkELwuS/R5X%\">Food</variable><variable type=\"KIND_SpriteKind\" id=\"f^OWsQ@V(ZZta!0jV43p\">Enemy</variable></variables><comment x=\"0\" y=\"0\" w=\"410\" h=\"120\">\nPixel Passport (Bluetooth) Extension demo\n</comment><comment x=\"0\" y=\"0\" w=\"480\" h=\"120\">\nRequires Browser Events + Sprite Data extensions.\n</comment><block type=\"pxt-on-start\" x=\"20\" y=\"20\"><statement name=\"HANDLER\"><block type=\"PixelPassportBluetooth_startReceiver\"></block></statement></block><block type=\"PixelPassportBluetooth_onMonsterReceived\" x=\"308\" y=\"20\"><statement name=\"HANDLER\"><block type=\"variables_set\"><field name=\"VAR\" id=\"Oou*Vk,sOPSoJh3Ay69Y\">My_Monster</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"PixelPassportBluetooth_createMonster\"><value name=\"kind\"><shadow type=\"spritekind\"><field name=\"MEMBER\">Player</field></shadow></value></block></value><next><block type=\"controls_if\"><value name=\"IF0\"><shadow type=\"logic_boolean\"><field name=\"BOOL\">TRUE</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"Oou*Vk,sO