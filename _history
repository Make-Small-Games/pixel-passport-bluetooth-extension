erEvents.Y, browserEvents.Z\n    ]\n\n    function fail(message: string) {\n        errorText = message\n        state = 3\n        console.log(\"Pixel Passport: \" + message + \" (\" + incoming.length + \"/269)\")\n        if (errorHandler) errorHandler()\n    }\n\n    function decodeMonster() {\n        // Same validation and decoding as the working compact receiver.\n        for (let i = 0; i < 256; i++) {\n            if (PIXELS.indexOf(incoming.charAt(i)) < 0) {\n                fail(\"INVALID SPRITE\")\n                return\n            }\n        }\n        if (FACINGS.indexOf(incoming.charAt(256)) < 0) {\n            fail(\"INVALID FACING\")\n            return\n        }\n        for (let i = 257; i < TOTAL; i++) {\n            if (CODES.indexOf(incoming.charAt(i)) < 0) {\n                fail(\"INVALID DATA\")\n                return\n            }\n        }\n        let nextArt = image.create(16, 16)\n        for (let i = 0; i < 256; i++) {\n            nextArt.setPixel(i % 16, Math.idiv(i, 16),\n                PIXELS.indexOf(incoming.charAt(i)))\n        }\n        spriteArt = nextArt\n        facing = incoming.charAt(256)\n        typeCode = incoming.charAt(257)\n        health = CODES.indexOf(incoming.charAt(258))\n        attack = CODES.indexOf(incoming.charAt(259))\n        speed = CODES.indexOf(incoming.charAt(260))\n        reserved = incoming.substr(261, 8)\n        errorText = \"\"\n        state = 2\n        if (receivedHandler) receivedHandler()\n    }\n\n    function receiveCharacter(letter: string) {\n        if (state != 1) {\n            incoming = \"\"\n            errorText = \"\"\n            state = 1\n        }\n        incoming += letter\n        lastKeyTime = game.runtime()\n        if (incoming.length == TOTAL) decodeMonster()\n    }\n\n    // A named function keeps the correct index in every callback.\n    function registerKey(index: number) {\n        keys[index].onEvent(browserEvents.KeyEvent.Pressed, function () {\n            receiveCharacter(CODES.charAt(index))\n        })\n    }\n\n    function showProgress() {\n        if (!drawLoadingBar || state != 1) return\n        screen.fill(1)\n        screen.fillRect(13, 55, 134, 16, 15)\n        screen.fillRect(15, 57, 130, 12, 1)\n        screen.fillRect(15, 57, Math.idiv(incoming.length * 130, TOTAL), 12, 7)\n        let count = \"\" + incoming.length + \" / 269\"\n        screen.print(count, Math.idiv(160 - count.length * 6, 2), 80, 15)\n    }\n\n    /** Start listening for Bluetooth keyboard input once per game. */\n    //% block=\"start Bluetooth receiver\"\n    //% weight=100\n    export function startReceiver() {\n        if (started) return\n        started = true\n        for (let i = 0; i < keys.length; i++) registerKey(i)\n        game.onUpdateInterval(250, function () {\n            if (state == 1 && game.runtime() - lastKeyTime > 8000) {\n                fail(\"SCAN TIMED OUT\")\n            }\n        })\n        game.onPaint(function () {\n            showProgress()\n        })\n    }\n\n    /** Run when a complete monster has arrived. */\n    //% block=\"on monster received\"\n    //% weight=95\n    export function onMonsterReceived(handler: () => void) {\n        receivedHandler = handler\n    }\n\n    /** The monster's original 16x16 pixel image. */\n    //% block=\"monster image\"\n    //% weight=90\n    export function monsterImage(): Image {\n        return spriteArt.clone()\n    }\n\n    /** The monster's one-letter type. */\n    //% block=\"monster type\"\n    //% weight=85\n    export function monsterType(): string {\n        return typeCode\n    }\n\n    /** The monster's facing (L, F, R). */\n    //% block=\"monster facing\"\n    //% weight=80\n    export function monsterFacing(): string {\n        return facing\n    }\n\n    /** Health value (0-35). */\n    //% block=\"monster health\"\n    //% weight=75\n    export function monsterHealth(): number {\n        return health\n    }\n\n    /** Attack value (0-35). */\n    //% block=\"monster attack\"\n    //% weight=70\n    export function monsterAttack(): number {\n        return attack\n    }\n\n    /** Speed value (0-35). */\n    //% block=\"monster speed\"\n    //% weight=65\n    export function monsterSpeed(): number {\n        return speed\n    }\n\n    /**\n     * Create a sprite from the most recently received monster.\n     * This does not destroy earlier sprites or impose game rules.\n     * Returns null if no monster has been received yet.\n     *\n     * Sprite Data keys:\n     *   Monster Type      (string, e.g. W)\n     *   Monster Facing    (string, L/F/R)\n     *   Monster Health    (number, 0-35)\n     *   Monster Attack    (number, 0-35)\n     *   Monster Speed     (number, 0-35)\n     *   Monster Reserved  (string, 8 characters)\n     */\n    //% block=\"create Pixel Passport monster of kind $kind\"\n    //% kind.shadow=\"spritekind\"\n    //% blockSetVariable=My_Monster\n    //% weight=88\n    export function createMonster(kind: number): Sprite {\n        // An empty type means no successful scan has occurred.\n        if (typeCode == \"\") return null\n\n        let monster = sprites.create(spriteArt.clone(), kind)\n        sprites.setDataString(monster, \"Monster Type\", typeCode)\n        sprites.setDataString(monster, \"Monster Facing\", facing)\n        sprites.setDataNumber(monster, \"Monster Health\", health)\n        sprites.setDataNumber(monster, \"Monster Attack\", attack)\n        sprites.setDataNumber(monster, \"Monster Speed\", speed)\n        sprites.setDataString(monster, \"Monster Reserved\", reserved)\n        return monster\n    }\n\n    /** True while importing a monster. */\n    //% block=\"monster is loading\"\n    //% weight=60\n    export function isLoading(): boolean {\n        return state == 1\n    }\n\n    /** Enable or disable the full-screen progress bar. */\n    //% block=\"show loading bar $enabled\"\n    //% enabled.shadow=\"toggleOnOff\"\n    //% weight=55\n    export function showLoadingBar(enabled: boolean) {\n        drawLoadingBar = enabled\n    }\n\n    /** Run when a transfer is incomplete or invalid. */\n    //% block=\"on monster scan error\"\n    //% weight=40 advanced=true\n    export function onMonsterError(handler: () => void) {\n        errorHandler = handler\n    }\n\n    /** The last error message. */\n    //% block=\"monster scan error text\"\n    //% weight=35 advanced=true\n    export function lastError(): string {\n        return errorText\n    }\n\n    /** The 8 reserved characters (future format use). */\n    //% block=\"monster reserved data\"\n    //% weight=30 advanced=true\n    export function monsterReserved(): string {\n        return reserved\n    }\n\n    /** Original 269-character code from last completed scan. */\n    //% block=\"monster raw code\"\n    //% weight=25 advanced=true\n    export function rawCode(): string {\n        if (state == 2) return incoming\n        return \"\"\n    }\n}\n","pxt.json":"{\n    \"name\": \"Pixel Passport (Bluetooth) Extension\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\",\n        \"browser-events\": \"*\",\n        \"arcade-sprite-data\": \"github:microsoft/arcade-sprite-data#v0.2.1\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\",\n        \"custom.ts\"\n    ],\n    \"preferredEditor\": \"blocksprj\"\n}\n"}},{"timestamp":1792389221167,"editorVersion":"4.1.25","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"}Q%{i%}@%9,Gx|W){PG:\">My_Monster</variable><variable type=\"KIND_SpriteKind\" id=\"(jk[[,PT+BuH%z1U#_?Y\">Player</variable><variable type=\"KIND_SpriteKind\" id=\"*8m6CkB3XU:(He4d;-WN\">Projectile</variable><variable type=\"KIND_SpriteKind\" id=\"}VOe5(kuZX+AB2tGcNz$\">Food</variable><variable type=\"KIND_SpriteKind\" id=\"nGVo+~orzdJBb%L6D8Xt\">Enemy</variable></variables><comment x=\"20\" y=\"6